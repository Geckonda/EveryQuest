# Настройки для сервера. Скопируйте в .env и заполните:
#   cp .env.prod.example .env && nano .env
# Файл .env в git не попадает — пароли остаются только на сервере.

# Адрес, по которому открывается приложение. Без своего домена подойдёт адрес
# от sslip.io — он сразу указывает на IP сервера (точки в IP заменить на дефисы):
DOMAIN=94-232-42-149.sslip.io
# Пароль базы — длинный и случайный. Именно -hex: он подставляется в URL подключения,
# а символы + / = из base64 его ломают. Сгенерировать:  openssl rand -hex 32
POSTGRES_PASSWORD=
# Секрет подписи токенов, не короче 32 символов. Сгенерировать:  openssl rand -base64 48
JWT_SECRET=

# Сколько дней хранить ежедневные дампы базы в ./backups.
BACKUP_KEEP_DAYS=14
